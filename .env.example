# Canonical list of environment variables for the Verbatim web app.
# Copy this file to `.env.local` and fill in the values. Only `NEXT_PUBLIC_`
# variables reach the browser. Keep every token without that prefix on the
# server.

# --- PostHog product analytics (client-safe) ---
# Project API key. Public by design: it ships to the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host. This project lives on PostHog EU Cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Clerk authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Sanity content (client-safe project ids) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-02
# Read token for the private dataset. Server only.
SANITY_API_READ_TOKEN=
